# Copy to backend/.env. Without any model configured Strata still indexes, navigates and edits; it just shows no summaries.
ANTHROPIC_API_KEY=

# Optional: run summaries on a local Ollama model instead ("ollama:<model>").
# STRATA_LEAF_MODEL=ollama:qwen2.5-coder:7b     # functions (default: claude-haiku-4-5)
# STRATA_BRANCH_MODEL=claude-opus-5             # classes/modules/dirs
# OLLAMA_HOST=http://127.0.0.1:11434
